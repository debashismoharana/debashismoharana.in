---
import { SITE_CONTENT, SITE_CONFIG } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import Experience from "@components/Experience.astro";
import Projects from "@components/Projects.astro";
import Contact from "@components/Contact.astro";

import "../styles/global.css";

const theOtherSideData = SITE_CONTENT.theOtherSide;
---

<Layout>
  <!-- Toggle Switch -->
  <div class="flex justify-center mt-6 mb-4">
    <div class="bg-[#12161d] p-1.5 rounded-full flex relative border border-neutral/20 w-max">
      <div id="toggle-indicator" class="absolute top-1.5 bottom-1.5 left-1.5 w-36 bg-primary rounded-full transition-transform duration-300 ease-in-out"></div>
      
      <button 
        id="btn-professional" 
        class="relative z-10 w-36 py-2.5 text-sm font-medium rounded-full transition-colors duration-300 text-[#12161d] text-center"
      >
        Professional
      </button>
      
      <button 
        id="btn-personal" 
        class="relative z-10 w-36 py-2.5 text-sm font-medium rounded-full transition-colors duration-300 text-white text-center"
      >
        Personal
      </button>
    </div>
  </div>

  <Hero {...SITE_CONTENT.hero} />

  <!-- Professional Content -->
  <div id="content-professional" class="transition-opacity duration-300">
    <Experience experience={SITE_CONTENT.experience} />
    <Projects projects={SITE_CONTENT.projects} />
  </div>

  <!-- Personal Content -->
  <div id="content-personal" class="hidden opacity-0 transition-opacity duration-300">
    <section class="py-12 md:py-16">
      <h2 class="mb-6 font-serif text-5xl font-bold tracking-tightest text-white sm:text-6xl">
        The Other Side
      </h2>
      <p class="mb-12 text-xl font-normal text-neutral leading-relaxed max-w-3xl">
        Beyond the code, here is a glimpse into what keeps me inspired, grounded, and caffeinated.
      </p>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {
          theOtherSideData.items.map(({ title, description, link }) => (
            <div class="rounded-3xl border border-neutral/20 bg-[#12161d] p-8 hover:bg-[#1c232d]/80 transition-colors flex flex-col justify-between group">
              <div>
                  <h3 class="mb-4 font-serif text-3xl font-medium text-primary">
                  {title}
                  </h3>
                  <p class="text-lg text-neutral mb-8 leading-relaxed group-hover:text-neutral-light transition-colors">{description}</p>
              </div>
              {link && (
                <div>
                  <a
                    href={link}
                    target="_blank"
                    class="inline-block rounded-full bg-primary/20 px-6 py-3 text-sm leading-5 font-medium text-primary hover:bg-primary hover:text-white transition-colors"
                  >
                    View More
                  </a>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- Contact Section -->
  <Contact socialLinks={SITE_CONFIG.socialLinks} contactFormKey={SITE_CONFIG.contactFormKey} />
</Layout>

<script>
  const btnProfessional = document.getElementById('btn-professional');
  const btnPersonal = document.getElementById('btn-personal');
  const contentProfessional = document.getElementById('content-professional');
  const contentPersonal = document.getElementById('content-personal');
  const toggleIndicator = document.getElementById('toggle-indicator');
  
  const heroProfessional = document.getElementById('hero-professional');
  const heroPersonal = document.getElementById('hero-personal');
  const heroSpecialtyProfessional = document.getElementById('hero-specialty-professional');
  const heroSpecialtyPersonal = document.getElementById('hero-specialty-personal');

  function switchTab(tab: 'professional' | 'personal') {
    if (!btnProfessional || !btnPersonal || !contentProfessional || !contentPersonal || !toggleIndicator || !heroProfessional || !heroPersonal || !heroSpecialtyProfessional || !heroSpecialtyPersonal) return;

    if (tab === 'professional') {
      // Move indicator
      toggleIndicator.style.transform = 'translateX(0)';
      
      // Update text colors
      btnProfessional.classList.add('text-[#12161d]');
      btnProfessional.classList.remove('text-white');
      
      btnPersonal.classList.add('text-white');
      btnPersonal.classList.remove('text-[#12161d]');

      const navProfItems = document.querySelectorAll('.nav-prof-item');
      
      // Switch content & hero
      contentPersonal.classList.add('opacity-0');
      heroPersonal.classList.add('opacity-0');
      heroSpecialtyPersonal.classList.add('opacity-0');
      
      navProfItems.forEach(item => {
        item.classList.remove('hidden');
        setTimeout(() => item.classList.remove('opacity-0'), 20);
      });

      setTimeout(() => {
        contentPersonal.classList.add('hidden');
        heroPersonal.classList.add('hidden');
        heroSpecialtyPersonal.classList.add('hidden');
        
        contentProfessional.classList.remove('hidden');
        heroProfessional.classList.remove('hidden');
        heroSpecialtyProfessional.classList.remove('hidden');
        
        // Small delay to allow display:block to apply before animating opacity
        setTimeout(() => {
          contentProfessional.classList.remove('opacity-0');
          heroProfessional.classList.remove('opacity-0');
          heroSpecialtyProfessional.classList.remove('opacity-0');
        }, 20);
      }, 300);

    } else {
      // Move indicator
      toggleIndicator.style.transform = 'translateX(144px)';
      
      // Update text colors
      btnPersonal.classList.add('text-[#12161d]');
      btnPersonal.classList.remove('text-white');
      
      btnProfessional.classList.add('text-white');
      btnProfessional.classList.remove('text-[#12161d]');

      const navProfItems = document.querySelectorAll('.nav-prof-item');
      
      // Switch content & hero
      contentProfessional.classList.add('opacity-0');
      heroProfessional.classList.add('opacity-0');
      heroSpecialtyProfessional.classList.add('opacity-0');
      
      navProfItems.forEach(item => {
        item.classList.add('opacity-0');
        setTimeout(() => item.classList.add('hidden'), 300);
      });

      setTimeout(() => {
        contentProfessional.classList.add('hidden');
        heroProfessional.classList.add('hidden');
        heroSpecialtyProfessional.classList.add('hidden');
        
        contentPersonal.classList.remove('hidden');
        heroPersonal.classList.remove('hidden');
        heroSpecialtyPersonal.classList.remove('hidden');
        
        setTimeout(() => {
          contentPersonal.classList.remove('opacity-0');
          heroPersonal.classList.remove('opacity-0');
          heroSpecialtyPersonal.classList.remove('opacity-0');
        }, 20);
      }, 300);
    }
  }

  btnProfessional?.addEventListener('click', () => switchTab('professional'));
  btnPersonal?.addEventListener('click', () => switchTab('personal'));
</script>
