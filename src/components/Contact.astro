---
interface Props {
  socialLinks: { text: string; href: string }[];
  contactFormKey?: string;
}

const { socialLinks, contactFormKey } = Astro.props;

const getIcon = (name: string) => {
  const icons: Record<string, string> = {
    LinkedIn: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`,
    Github: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
    Instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
    Email: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`
  };
  return icons[name] || icons.Email;
};
---

<section id="contact" class="py-24">
  <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
    <!-- Social Links and Info -->
    <div>
      <h3 class="mb-5 font-serif text-3xl font-medium text-white">
        Get In Touch
      </h3>
      <p class="mb-10 text-lg text-neutral">
        Whether you have a question, a project idea, or just want to chat about code and coffee, I'm always open to new connections.
      </p>
      
      <div class="flex flex-col gap-6">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              class="flex items-center gap-4 group text-neutral hover:text-white transition-colors w-max text-lg"
            >
              <div class="p-3 rounded-xl bg-[#12161d] border border-neutral/20 group-hover:border-primary/50 group-hover:text-primary transition-colors" set:html={getIcon(link.text)} />
              <span class="font-medium">{link.text}</span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Basic Contact Form -->
    <div class="rounded-3xl border border-neutral/20 bg-[#12161d] p-8 relative overflow-hidden min-h-[400px]">
      
      <!-- Success Message overlay -->
      <div id="success-message" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-[#12161d] opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="rounded-full bg-green-500/20 p-4 mb-6">
          <svg class="w-12 h-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h4 class="text-2xl font-serif font-medium text-white mb-2">Message Sent!</h4>
        <p class="text-neutral mb-8 text-center px-6">Thanks for reaching out. I'll get back to you as soon as I finish my coffee.</p>
        <button id="btn-send-another" type="button" class="text-primary hover:text-white transition-colors underline underline-offset-4 decoration-primary/50">
          Send another message
        </button>
      </div>

      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-5 relative z-10 transition-opacity duration-300" data-key={contactFormKey}>
        
        <input type="hidden" name="access_key" value={contactFormKey || "mock-key"} />
        <input type="hidden" name="subject" value="New Message from debashismoharana.in" />
        <input type="hidden" name="from_name" value="Portfolio Contact Form" />

        <div class="flex flex-col gap-2">
          <label for="name" class="text-sm text-neutral">Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required
            class="rounded-xl border border-neutral/20 bg-black px-4 py-3 text-white focus:border-primary focus:outline-none transition-colors"
            placeholder="Your Name"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="text-sm text-neutral">Email</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required
            class="rounded-xl border border-neutral/20 bg-black px-4 py-3 text-white focus:border-primary focus:outline-none transition-colors"
            placeholder="your@email.com"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="text-sm text-neutral">Message</label>
          <textarea 
            id="message" 
            name="message" 
            rows="4" 
            required
            class="rounded-xl border border-neutral/20 bg-black px-4 py-3 text-white focus:border-primary focus:outline-none transition-colors resize-none"
            placeholder="How can I help?"
          ></textarea>
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="mt-2 rounded-full bg-primary py-4 text-sm font-medium text-white hover:bg-primary/90 transition-colors"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const btnSendAnother = document.getElementById('btn-send-another');
  const submitBtn = document.getElementById('submit-btn');

  if (form && successMessage && btnSendAnother && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const originalBtnText = submitBtn.innerText;
      submitBtn.innerText = 'Sending...';
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

      const accessKey = form.getAttribute('data-key');

      try {
        if (!accessKey) {
          // Mock send for testing/development if no key is provided
          await new Promise(resolve => setTimeout(resolve, 1500));
          showSuccess();
          return;
        }

        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          showSuccess();
        } else {
          alert('Something went wrong. Please try again or reach out directly via email.');
        }
      } catch (error) {
        alert('Something went wrong. Please try again or reach out directly via email.');
      } finally {
        submitBtn.innerText = originalBtnText;
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    });

    btnSendAnother.addEventListener('click', () => {
      form.reset();
      successMessage.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        form.classList.remove('opacity-0', 'pointer-events-none');
      }, 300);
    });

    function showSuccess() {
      if (!form || !successMessage) return;
      form.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        successMessage?.classList.remove('opacity-0', 'pointer-events-none');
      }, 300);
    }
  }
</script>
