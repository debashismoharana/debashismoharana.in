---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, professionalSpecialty, professionalSubtitle, personalSpecialty, professionalSummary, personalSummary } = Astro.props;
---

<section class="pb-8 md:pb-8 pt-4" id="#hero">
  <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
  >
    {name}
  </h1>
  <div id="hero-specialty-professional" class="mb-9 transition-opacity duration-300">
    <p class="font-serif text-4xl leading-11.5 font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl mb-2">
      {professionalSpecialty}
    </p>
    {professionalSubtitle && (
      <p class="text-xl md:text-xl text-white/80 font-medium tracking-tight">
        {professionalSubtitle}
      </p>
    )}
  </div>
  <p id="hero-specialty-personal" class="mb-9 font-serif text-4xl leading-11.5 font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl hidden opacity-0 transition-opacity duration-300">
    {personalSpecialty}
  </p>
  <p id="hero-professional" class="mb-4 text-base font-normal text-neutral md:text-lg max-w-4xl leading-relaxed transition-opacity duration-300">
    {professionalSummary}
  </p>
  <p id="hero-personal" class="mb-4 text-base font-normal text-neutral md:text-lg max-w-4xl leading-relaxed hidden opacity-0 transition-opacity duration-300">
    {personalSummary}
  </p>
</section>
